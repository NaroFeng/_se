{
  "name": "html-block-assembler",
  "version": "1.0.0",
  "description": "建置期 HTML 區塊組裝 CLI 套件：把 <block> 標籤在編譯期展開成完整網頁，專為 HTML 初學者設計（單層平鋪架構、直接輸出至專案根目錄）。",
  "type": "module",
  "main": "lib/compiler.js",
  "exports": {
    ".": "./lib/compiler.js",
    "./compiler": "./lib/compiler.js",
    "./watcher": "./lib/watcher.js",
    "./init": "./lib/init.js"
  },
  "bin": {
    "html-block": "bin/cli.js"
  },
  "files": [
    "bin/",
    "lib/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "init": "node ./bin/cli.js init",
    "build": "node ./bin/cli.js build",
    "watch": "node ./bin/cli.js watch",
    "test": "node --test"
  },
  "keywords": [
    "html",
    "cli",
    "static-site-generator",
    "template",
    "block",
    "beginner",
    "build-tool"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=18.3.0"
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "node-html-parser": "^7.0.1",
    "picocolors": "^1.1.1"
  }
}
